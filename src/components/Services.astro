---
const services = [
  {
    id: 'market-making',
    label: '01',
    title: 'Market Making',
    description: 'We provide continuous, two-sided liquidity across decentralized venues. Our strategies align DEX pricing with CEX benchmarks, tightening spreads and reducing slippage for all market participants.',
    features: [
      'Continuous bid-ask quoting across DEX orderbooks and AMMs',
      'CEX-DEX price alignment and arbitrage reduction',
      'Custom liquidity programs for token issuers',
      'Multi-chain coverage across major L1s and L2s',
    ],
    cta: { label: 'Request a Quote', href: '#contact' },
  },
  {
    id: 'terminal',
    title: 'Trading Terminal',
    label: '02',
    description: 'Access institutional-grade RFQ trading through our terminal. Complete KYC/KYB onboarding and trade directly with competitive pricing and deep liquidity pools.',
    features: [
      'Request-for-quote (RFQ) based execution',
      'Competitive institutional pricing',
      'Streamlined KYC/KYB onboarding',
      'Secure, compliant trade settlement',
    ],
    cta: { label: 'Launch Terminal', href: '#terminal' },
  },
];
---

<section id="services" class="section-padding relative">
  <!-- Divider -->
  <div class="container-main"><hr class="mb-24 md:mb-34" /></div>

  <div class="container-main">
    <div class="reveal mb-20">
      <div class="label mb-6">Services</div>
      <h2 class="font-heading text-h2 text-white max-w-2xl">
        Two Ways to Access Our Liquidity
      </h2>
    </div>

    <div class="space-y-20 lg:space-y-30">
      {services.map((service, idx) => (
        <div class="reveal grid lg:grid-cols-12 gap-10 lg:gap-16 items-start" style={`transition-delay: ${idx * 0.1}s;`}>
          <!-- Number -->
          <div class="lg:col-span-1">
            <span class="font-mono text-caption text-accent">{service.label}</span>
          </div>

          <!-- Content -->
          <div class="lg:col-span-5">
            <h3 class="font-heading text-h3 text-white mb-5">{service.title}</h3>
            <p class="text-body-lg text-steel-300 mb-8">{service.description}</p>
            <a href={service.cta.href} class={idx === 0 ? 'btn-secondary' : 'btn-primary'}>
              {service.cta.label}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 8h10M9 4l4 4-4 4"/>
              </svg>
            </a>
          </div>

          <!-- Features -->
          <div class="lg:col-span-5 lg:col-start-8">
            <div class="glass rounded-sm p-8">
              <ul class="space-y-5">
                {service.features.map((feature) => (
                  <li class="flex gap-4 text-body text-steel-200">
                    <svg class="w-5 h-5 text-accent mt-0.5 shrink-0" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 10l4 4 8-8"/>
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
