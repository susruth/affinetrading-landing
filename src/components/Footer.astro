---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/[0.04] pt-24 pb-12">
  <div class="container-main">
    <div class="grid md:grid-cols-12 gap-16 mb-24">
      <!-- Brand -->
      <div class="md:col-span-5">
        <a href="/" class="flex items-center gap-3 mb-8">
          <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
            <path d="M8 26L16 6L24 26" stroke="#3ECFB4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="11" y1="19.5" x2="21" y2="19.5" stroke="#3ECFB4" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="text-white font-heading text-lg">Affine Trading</span>
        </a>
        <p class="text-body-sm text-steel-500 max-w-xs leading-relaxed mb-10">
          Accelerating the decentralization of global trading infrastructure through institutional-grade market making.
        </p>
        <!-- Social -->
        <div class="flex gap-3">
          <a href="#" class="w-9 h-9 flex items-center justify-center border border-white/[0.06] text-steel-500 hover:text-accent hover:border-accent/20 transition-all duration-500" aria-label="X">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 flex items-center justify-center border border-white/[0.06] text-steel-500 hover:text-accent hover:border-accent/20 transition-all duration-500" aria-label="LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div class="md:col-span-2 md:col-start-7">
        <h4 class="text-caption uppercase tracking-[0.2em] text-steel-600 font-mono mb-6">Company</h4>
        <ul class="space-y-4">
          <li><a href="#about" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">About</a></li>
          <li><a href="#services" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Services</a></li>
          <li><a href="#approach" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Approach</a></li>
          <li><a href="#contact" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Contact</a></li>
        </ul>
      </div>

      <!-- Products -->
      <div class="md:col-span-2">
        <h4 class="text-caption uppercase tracking-[0.2em] text-steel-600 font-mono mb-6">Products</h4>
        <ul class="space-y-4">
          <li><a href="#services" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Market Making</a></li>
          <li><a href="#terminal" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Trading Terminal</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div class="md:col-span-2">
        <h4 class="text-caption uppercase tracking-[0.2em] text-steel-600 font-mono mb-6">Legal</h4>
        <ul class="space-y-4">
          <li><a href="#" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Privacy</a></li>
          <li><a href="#" class="text-body-sm text-steel-400 hover:text-white transition-colors duration-300">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-white/[0.04] flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-caption text-steel-600">&copy; {currentYear} Affine Trading. All rights reserved.</p>
    </div>
  </div>
</footer>
