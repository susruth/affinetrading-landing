---
// A subtle ticker/marquee between sections to add visual rhythm
const items = [
  'Market Making',
  'DEX Liquidity',
  'Price Parity',
  'RFQ Trading',
  'CEX-DEX Alignment',
  'Institutional Grade',
  'Multi-Chain',
  'Always On',
];
---

<div class="overflow-hidden border-y border-white/[0.04] py-5 select-none">
  <div class="marquee-track flex gap-12 whitespace-nowrap">
    {[...items, ...items, ...items].map((item) => (
      <span class="flex items-center gap-12 text-body-sm text-steel-600 font-mono uppercase tracking-widest">
        {item}
        <span class="w-1.5 h-1.5 rounded-full bg-accent/30"></span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 40s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>
