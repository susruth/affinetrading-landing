---
const items = [
  'Market Making',
  'DEX Liquidity',
  'Price Parity',
  'RFQ Trading',
  'CEX-DEX Alignment',
  'Multi-Chain',
  'Institutional Grade',
  'Always On',
];
---

<div class="border-y border-white/[0.04] py-6 overflow-hidden select-none">
  <div class="marquee-track flex whitespace-nowrap">
    {[...items, ...items, ...items, ...items].map((item) => (
      <span class="flex items-center gap-10 mx-10 text-[11px] text-steel-600 font-mono uppercase tracking-[0.25em]">
        {item}
        <span class="w-1 h-1 rounded-full bg-accent/25 shrink-0"></span>
      </span>
    ))}
  </div>
</div>
