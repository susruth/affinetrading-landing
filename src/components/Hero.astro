---
---

<section class="relative min-h-[100vh] flex items-center overflow-hidden">
  <!-- Ambient glow — top right -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent/[0.03] rounded-full blur-[150px] translate-x-1/3 -translate-y-1/4"></div>

  <!-- Ambient glow — bottom left -->
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-accent/[0.02] rounded-full blur-[120px] -translate-x-1/3 translate-y-1/4"></div>

  <!-- Grid pattern — very subtle -->
  <div class="absolute inset-0 opacity-[0.025]" style="background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 120px 120px;"></div>

  <!-- Single decorative line -->
  <div class="absolute right-[15%] top-0 w-px h-full bg-gradient-to-b from-transparent via-white/[0.04] to-transparent hidden lg:block"></div>

  <div class="container-main relative z-10 pt-48 pb-32 lg:pt-56 lg:pb-40">
    <div class="max-w-3xl">
      <!-- Eyebrow -->
      <div class="hero-fade label mb-10" style="--delay: 0s;">
        Institutional DeFi Market Making
      </div>

      <!-- Headline — split for dramatic effect -->
      <h1 class="font-heading text-display text-white mb-10 hero-fade" style="--delay: 0.15s;">
        Bringing Price Parity
      </h1>

      <h1 class="font-heading text-display hero-fade mb-14" style="--delay: 0.3s;">
        <span class="text-gradient">Between CEX & DEX</span>
      </h1>

      <!-- Subhead -->
      <p class="text-body-lg text-steel-400 max-w-xl mb-16 hero-fade leading-relaxed" style="--delay: 0.5s;">
        Institutional-grade market making across decentralized exchanges.
        We align on-chain pricing with global benchmarks to drive efficient,
        liquid markets.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 hero-fade" style="--delay: 0.65s;">
        <a href="#contact" class="btn-primary group">
          <span>Request a Quote</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500 group-hover:translate-x-1">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
        <a href="#terminal" class="btn-secondary group">
          <span>Launch Trading Terminal</span>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500 group-hover:translate-x-1">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 hero-fade" style="--delay: 1.2s;">
      <div class="w-px h-12 bg-gradient-to-b from-steel-600/50 to-transparent relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-4 bg-accent/40 animate-[scrollPulse_2s_ease-in-out_infinite]"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-fade {
    opacity: 0;
    transform: translateY(28px);
    animation: heroFadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scrollPulse {
    0%, 100% { transform: translateY(-100%); }
    50% { transform: translateY(200%); }
  }
</style>
