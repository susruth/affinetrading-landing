---
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background grid -->
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 80px 80px;"></div>

  <!-- Radial glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-accent/[0.04] rounded-full blur-[120px]"></div>

  <div class="container-main relative z-10 pt-32 pb-20">
    <div class="max-w-4xl">
      <!-- Label -->
      <div class="label mb-8 animate-fade-in">Institutional DeFi Market Making</div>

      <!-- Headline -->
      <h1 class="font-heading text-display text-white mb-8 animate-fade-up" style="animation-delay: 0.1s;">
        Bringing Price Parity<br/>
        <span class="text-gradient">Between CEX & DEX</span>
      </h1>

      <!-- Subhead -->
      <p class="text-body-lg text-steel-300 max-w-2xl mb-12 animate-fade-up" style="animation-delay: 0.25s;">
        We provide institutional-grade market making across decentralized exchanges,
        aligning on-chain pricing with global benchmarks to drive efficient,
        liquid markets.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 animate-fade-up" style="animation-delay: 0.4s;">
        <a href="#contact" class="btn-primary">
          Request a Quote
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
        <a href="#terminal" class="btn-secondary">
          Launch Trading Terminal
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 4l5 4-5 4M8 12h6"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 text-steel-500 animate-fade-in" style="animation-delay: 1s;">
      <span class="text-caption tracking-widest">Scroll</span>
      <div class="w-px h-8 bg-gradient-to-b from-steel-500 to-transparent"></div>
    </div>
  </div>

  <!-- Decorative lines -->
  <div class="absolute right-0 top-1/4 w-px h-48 bg-gradient-to-b from-transparent via-accent/20 to-transparent"></div>
  <div class="absolute right-20 top-1/3 w-px h-32 bg-gradient-to-b from-transparent via-steel-700/30 to-transparent"></div>
</section>
