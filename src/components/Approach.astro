---
const pillars = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>`,
    title: 'Always On',
    description: 'Our infrastructure runs 24/7 across every time zone and market cycle, providing uninterrupted liquidity regardless of volatility.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 5 4-10"/></svg>`,
    title: 'CEX-Grade Pricing',
    description: 'Proprietary models continuously reference centralized exchange benchmarks, ensuring DEX prices remain aligned with the global market.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: 'Institutional Rigor',
    description: 'Built by practitioners from traditional finance and crypto-native firms. We apply institutional risk management and compliance standards.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Multi-Chain Native',
    description: 'Seamless operations across Ethereum, Solana, and major L2 ecosystems. We go where the liquidity is needed.',
  },
];
---

<section id="approach" class="section-padding relative">
  <div class="container-main"><hr class="mb-24 md:mb-34" /></div>

  <div class="container-main">
    <div class="reveal max-w-2xl mb-20">
      <div class="label mb-6">Our Approach</div>
      <h2 class="font-heading text-h2 text-white mb-6">
        Infrastructure-Grade Market Making
      </h2>
      <p class="text-body-lg text-steel-300">
        We treat market making as critical infrastructure. Our systems are designed for reliability, precision, and scale.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-px bg-white/[0.06] rounded-sm overflow-hidden">
      {pillars.map((pillar, i) => (
        <div class="reveal bg-midnight-950 p-10 lg:p-14 group hover:bg-white/[0.02] transition-colors duration-500" style={`transition-delay: ${i * 0.08}s;`}>
          <div class="w-10 h-10 text-accent mb-8 opacity-80 group-hover:opacity-100 transition-opacity" set:html={pillar.icon} />
          <h3 class="font-heading text-h4 text-white mb-4">{pillar.title}</h3>
          <p class="text-body text-steel-400">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
