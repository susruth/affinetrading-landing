---
const pillars = [
  {
    title: 'Always On',
    description: 'Our infrastructure runs 24/7 across every time zone and market cycle, providing uninterrupted liquidity regardless of volatility.',
  },
  {
    title: 'CEX-Grade Pricing',
    description: 'Proprietary models continuously reference centralized exchange benchmarks, ensuring DEX prices remain aligned with the global market.',
  },
  {
    title: 'Institutional Rigor',
    description: 'Built by practitioners from traditional finance and crypto-native firms. We apply institutional risk management and compliance standards.',
  },
  {
    title: 'Multi-Chain Native',
    description: 'Seamless operations across Ethereum, Solana, and major L2 ecosystems. We go where the liquidity is needed.',
  },
];
---

<section id="approach" class="py-34 md:py-42 lg:py-48 relative">
  <div class="container-main">
    <hr class="mb-34 lg:mb-42" />

    <div class="grid lg:grid-cols-12 gap-16 lg:gap-24 mb-24 lg:mb-34">
      <!-- Left header -->
      <div class="lg:col-span-5 reveal">
        <div class="label mb-8">Our Approach</div>
        <h2 class="font-heading text-h1 text-white">
          Infrastructure-Grade Market Making
        </h2>
      </div>
      <!-- Right description -->
      <div class="lg:col-span-5 lg:col-start-8 flex items-end reveal reveal-delay-2">
        <p class="text-body-lg text-steel-400 leading-[1.85]">
          We treat market making as critical infrastructure.
          Our systems are designed for reliability, precision, and scale —
          the same standards applied to the world's most demanding trading systems.
        </p>
      </div>
    </div>

    <!-- Pillar grid -->
    <div class="grid md:grid-cols-2 gap-px bg-white/[0.04] stagger-children">
      {pillars.map((pillar) => (
        <div class="bg-midnight-950 p-10 lg:p-16 group transition-all duration-700 hover:bg-white/[0.015]">
          <!-- Minimal dot indicator -->
          <div class="relative w-2 h-2 mb-10">
            <div class="w-2 h-2 rounded-full bg-accent/40 group-hover:bg-accent transition-colors duration-700"></div>
            <div class="absolute inset-0 w-2 h-2 rounded-full bg-accent/20 group-hover:scale-[3] group-hover:opacity-0 transition-all duration-1000"></div>
          </div>

          <h3 class="font-heading text-h3 text-white mb-5 group-hover:text-accent-light transition-colors duration-700">
            {pillar.title}
          </h3>
          <p class="text-body text-steel-400 leading-relaxed max-w-sm group-hover:text-steel-300 transition-colors duration-700">
            {pillar.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
