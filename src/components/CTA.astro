---
---

<section id="contact" class="py-34 md:py-42 lg:py-48 relative">
  <div class="container-main">
    <hr class="mb-34 lg:mb-42" />

    <!-- Section header -->
    <div class="reveal text-center mb-24 lg:mb-34">
      <div class="label mb-8">Get Started</div>
      <h2 class="font-heading text-h1 text-white max-w-2xl mx-auto mb-6">
        Ready to Work With Us?
      </h2>
      <p class="text-body-lg text-steel-400 max-w-lg mx-auto">
        Whether you need a market maker or want to access institutional pricing,
        we're here to help.
      </p>
    </div>

    <!-- Two CTA cards -->
    <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
      <!-- Market Making CTA -->
      <div class="reveal group">
        <div class="glass p-10 lg:p-14 h-full flex flex-col transition-all duration-700 hover:bg-white/[0.03] hover:border-white/[0.1]">
          <div class="label mb-10">For Token Projects & Exchanges</div>

          <h3 class="font-heading text-h3 text-white mb-5">
            Market Making
          </h3>

          <p class="text-body text-steel-400 leading-[1.85] mb-12 flex-grow">
            Looking for a liquidity partner? We work with token issuers,
            protocols, and exchanges to provide tailored market making solutions.
          </p>

          <a href="mailto:contact@affinetrading.com" class="btn-secondary w-fit group/btn">
            <span>Request a Quote</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500 group-hover/btn:translate-x-1">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Terminal CTA -->
      <div id="terminal" class="reveal reveal-delay-1 group">
        <div class="glass p-10 lg:p-14 h-full flex flex-col border-accent/[0.08] transition-all duration-700 hover:bg-accent/[0.03] hover:border-accent/[0.15]">
          <div class="label mb-10">For Institutional Traders</div>

          <h3 class="font-heading text-h3 text-white mb-5">
            Trading Terminal
          </h3>

          <p class="text-body text-steel-400 leading-[1.85] mb-12 flex-grow">
            Access competitive RFQ-based pricing through our trading platform.
            Complete KYC/KYB verification and start trading.
          </p>

          <a href="#" class="btn-primary w-fit group/btn">
            <span>Launch Terminal</span>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500 group-hover/btn:translate-x-1">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
