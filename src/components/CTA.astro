---
---

<section id="contact" class="section-padding relative">
  <div class="container-main"><hr class="mb-24 md:mb-34" /></div>

  <div class="container-main">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Left — Market Making -->
      <div class="reveal">
        <div class="glass rounded-sm p-10 lg:p-14 h-full flex flex-col">
          <div class="label mb-6">For Token Projects & Exchanges</div>
          <h3 class="font-heading text-h3 text-white mb-5">Market Making Services</h3>
          <p class="text-body text-steel-300 mb-10 flex-grow">
            Looking for a liquidity partner? We work with token issuers, protocols, and exchanges to provide tailored market making solutions. Get in touch to discuss your requirements.
          </p>
          <a href="mailto:contact@affinetrading.com" class="btn-secondary w-fit">
            Request a Quote
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8h10M9 4l4 4-4 4"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right — Terminal -->
      <div id="terminal" class="reveal" style="transition-delay: 0.1s;">
        <div class="glass rounded-sm p-10 lg:p-14 h-full flex flex-col border-accent/10">
          <div class="label mb-6">For Institutional Traders</div>
          <h3 class="font-heading text-h3 text-white mb-5">Trading Terminal</h3>
          <p class="text-body text-steel-300 mb-10 flex-grow">
            Access competitive RFQ-based pricing through our trading platform. Complete KYC/KYB verification and begin trading with institutional-grade execution.
          </p>
          <a href="#" class="btn-primary w-fit">
            Launch Terminal
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 4l5 4-5 4M8 12h6"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
